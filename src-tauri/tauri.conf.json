{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dbms-tool",
  "version": "0.1.0",
  "identifier": "com.asofianidis.dbms-tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dbms-tool",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0b0a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Database client for PostgreSQL, MySQL, SQL Server, Babelfish and MongoDB",
    "category": "DeveloperTool",
    "copyright": "MIT License"
  }
}
